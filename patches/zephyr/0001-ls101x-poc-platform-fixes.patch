+
+LOG_MODULE_REGISTER(sio_uart, CONFIG_ESPI_LOG_LEVEL);
+
+/* After SIO (CONFIG_KERNEL_INIT_PRIORITY_DEVICE == 50). Must be a single token. */
+#define SIO_UART_INIT_PRIORITY 51
+
+#define UART_IO_REGS 8
+#define LCR_DLAB     BIT(7)
+
+enum divisor_reg_status {
+	STATUS_NO_CHANGE,
+	SET_DLAB,
+	CLR_DLAB,
+};
+
+enum sio_uart_kind {
+	SIO_UART_DW,
+	SIO_UART_LS,
+};
+
+struct sio_uart_reg_cfg {
+	uint8_t ier;
+	uint8_t fcr;
+	uint8_t lcr;
+	uint8_t mcr;
+	uint8_t scr;
+};
+
+struct sio_lsuart_shadow {
+	uint8_t dll;
+	uint8_t dlm;
+	uint8_t ier;
+	uint8_t lcr;
+	uint8_t mcr;
+	uint8_t scr;
+	uint8_t fifo_flag;
+	uint8_t thr_flag;
+};
+
+struct sio_uart_config {
+	const struct device *espi;
+	const struct device *sio;
+	const struct pinctrl_dev_config *pcfg;
+	struct gpio_dt_spec dtr;
+	struct gpio_dt_spec dsr;
+	struct gpio_dt_spec ri;
+	struct gpio_dt_spec dcd;
+	mem_addr_t mmio;
+	uint32_t clock_hz;
+	uint16_t irqn;
+	uint16_t default_io;
+	uint8_t default_irq;
+	uint8_t ldn;
+	enum sio_uart_kind kind;
+	void (*irq_config)(const struct device *dev);
+};
+
+struct sio_uart_data {
+	struct peri_ioport_content content[UART_IO_REGS];
+	struct peri_ioport ioport[UART_IO_REGS];
+	struct sio_uart_reg_cfg regs;
+	struct sio_lsuart_shadow ls;
+	uint16_t mapped_base;
+	uint8_t host_irq;
+	bool mapped;
+};
+
+static void nop4(void)
+{
+	__asm__ volatile("nop");
+	__asm__ volatile("nop");
+	__asm__ volatile("nop");
+	__asm__ volatile("nop");
+}
+
+static bool is_dwuart(mem_addr_t base)
+{
+	return base == DWUART1_BASE_ADDR || base == DWUART2_BASE_ADDR;
+}
+
+static bool is_lsuart(mem_addr_t base)
+{
+	return base == UART1_BASE_ADDR || base == UART2_BASE_ADDR;
+}
+
+static volatile uint32_t *dw_regs(const struct sio_uart_config *cfg)
+{
+	return (volatile uint32_t *)cfg->mmio;
+}
+
+static reg_uart_t *ls_hw(const struct sio_uart_config *cfg)
+{
+	return (reg_uart_t *)cfg->mmio;
+}
+
+static void uart_clock_on(mem_addr_t base)
+{
+	if (base == DWUART1_BASE_ADDR) {
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_CLR_DWUART1_N_MASK;
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_SET_DWUART1_N_MASK;
+		SYSC_PER->PD_PER_CLKG1 = SYSC_PER_CLKG_SET_DWUART1_MASK;
+	} else if (base == DWUART2_BASE_ADDR) {
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_CLR_DWUART2_N_MASK;
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_SET_DWUART2_N_MASK;
+		SYSC_PER->PD_PER_CLKG1 = SYSC_PER_CLKG_SET_DWUART2_MASK;
+	} else if (base == UART1_BASE_ADDR) {
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_CLR_UART1_N_MASK;
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_SET_UART1_N_MASK;
+		SYSC_PER->PD_PER_CLKG1 = SYSC_PER_CLKG_SET_UART1_MASK;
+	} else if (base == UART2_BASE_ADDR) {
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_CLR_UART2_N_MASK;
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_SET_UART2_N_MASK;
+		SYSC_PER->PD_PER_CLKG1 = SYSC_PER_CLKG_SET_UART2_MASK;
+	}
+}
+
+static void dwuart_reset(mem_addr_t base)
+{
+	if (base == DWUART1_BASE_ADDR) {
+		SYSC_PER->PD_PER_CLKG1 = SYSC_PER_CLKG_CLR_DWUART1_MASK;
+		nop4();
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_CLR_DWUART1_N_MASK;
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_SET_DWUART1_N_MASK;
+		nop4();
+		SYSC_PER->PD_PER_CLKG1 = SYSC_PER_CLKG_SET_DWUART1_MASK;
+	} else if (base == DWUART2_BASE_ADDR) {
+		SYSC_PER->PD_PER_CLKG1 = SYSC_PER_CLKG_CLR_DWUART2_MASK;
+		nop4();
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_CLR_DWUART2_N_MASK;
+		SYSC_PER->PD_PER_SRST1 = SYSC_PER_SRST_SET_DWUART2_N_MASK;
+		nop4();
+		SYSC_PER->PD_PER_CLKG1 = SYSC_PER_CLKG_SET_DWUART2_MASK;
+	}
+}
+
+static void irq_state_update(const struct device *dev)
+{
+	const struct sio_uart_config *cfg = dev->config;
+
+	if (irq_is_enabled(cfg->irqn)) {
+		return;
+	}
+	clr_pending_irq(cfg->irqn);
+	if (!get_pending_irq(cfg->irqn)) {
+		irq_enable(cfg->irqn);
+	}
+}
+
+static void sio_uart_isr(const void *arg)
+{
+	const struct device *dev = arg;
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+
+	irq_disable(cfg->irqn);
+	espi_lpc_raise_edge_irq(cfg->espi, data->host_irq);
+}
+
+static uint8_t msr_from_gpio(const struct sio_uart_config *cfg)
+{
+	uint8_t msr = 0;
+
+	if (gpio_is_ready_dt(&cfg->dsr) && gpio_pin_get_dt(&cfg->dsr) > 0) {
+		msr |= BIT(5);
+	}
+	if (gpio_is_ready_dt(&cfg->ri) && gpio_pin_get_dt(&cfg->ri) > 0) {
+		msr |= BIT(6);
+	}
+	if (gpio_is_ready_dt(&cfg->dcd) && gpio_pin_get_dt(&cfg->dcd) > 0) {
+		msr |= BIT(7);
+	}
+	return msr;
+}
+
+static void apply_dtr(const struct sio_uart_config *cfg, uint8_t mcr)
+{
+	if (gpio_is_ready_dt(&cfg->dtr)) {
+		gpio_pin_set_dt(&cfg->dtr, (mcr & BIT(0)) ? 1 : 0);
+	}
+}
+
+static void spec_mul_div(uint8_t spec1, uint8_t *mul, uint8_t *div)
+{
+	switch ((spec1 & 0x06) >> 1) {
+	case 1:
+		*mul = 12;
+		*div = 1;
+		break;
+	case 2:
+		*mul = 1;
+		*div = 1;
+		break;
+	case 3:
+		*mul = 13;
+		*div = 8;
+		break;
+	default:
+		*mul = 13;
+		*div = 1;
+		break;
+	}
+}
+
+static uint16_t host_div_to_hw(uint32_t clock_hz, uint16_t host_div, uint8_t spec1)
+{
+	uint8_t mul, div;
+	uint32_t clk_mhz = clock_hz / 1000000u;
+	uint32_t hw;
+
+	spec_mul_div(spec1, &mul, &div);
+	if (host_div == 0 || div == 0 || clk_mhz == 0) {
+		return 1;
+	}
+	hw = clk_mhz * host_div * mul / (24u * div);
+	if (hw == 0) {
+		hw = 1;
+	}
+	if (hw > 0xffffu) {
+		hw = 0xffffu;
+	}
+	return (uint16_t)hw;
+}
+
+static uint8_t ldn_spec1(const struct sio_uart_config *cfg)
+{
+	struct sio_ls_ldn_info info;
+
+	if (sio_ls_ldn_info(cfg->sio, cfg->ldn, &info) == 0) {
+		return info.spec1;
+	}
+	return 0;
+}
+
+static enum divisor_reg_status dlab_status(uint8_t cur_lcr, uint8_t val, uint8_t offset)
+{
+	if (offset != 0x03) {
+		return STATUS_NO_CHANGE;
+	}
+	if ((cur_lcr & LCR_DLAB) && ((val & LCR_DLAB) == 0)) {
+		return CLR_DLAB;
+	}
+	if (((cur_lcr & LCR_DLAB) == 0) && (val & LCR_DLAB)) {
+		return SET_DLAB;
+	}
+	return STATUS_NO_CHANGE;
+}
+
+static void sio_uart_unmap(const struct device *dev)
+{
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+
+	if (!data->mapped) {
+		return;
+	}
+	for (int i = 0; i < UART_IO_REGS; i++) {
+		espi_lpc_remove_ioport(cfg->espi, &data->ioport[i]);
+	}
+	data->mapped = false;
+}
+
+static void sio_uart_on_ldn_change(const struct device *dev)
+{
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+	struct sio_ls_ldn_info info;
+
+	if (sio_ls_ldn_info(cfg->sio, cfg->ldn, &info) != 0) {
+		return;
+	}
+
+	data->host_irq = info.irq;
+
+	if ((info.act & BIT(0)) == 0) {
+		sio_uart_unmap(dev);
+		irq_disable(cfg->irqn);
+		return;
+	}
+
+	if (data->mapped) {
+		if (data->mapped_base != info.io_base) {
+			for (int i = 0; i < UART_IO_REGS; i++) {
+				data->content[i].addr = info.io_base + i;
+			}
+			data->mapped_base = info.io_base;
+		}
+		return;
+	}
+
+	for (int i = 0; i < UART_IO_REGS; i++) {
+		data->content[i].addr = info.io_base + i;
+		data->ioport[i].content = &data->content[i];
+		espi_lpc_add_ioport(cfg->espi, &data->ioport[i]);
+	}
+	data->mapped_base = info.io_base;
+	data->mapped = true;
+	irq_state_update(dev);
+}
+
+static void dwuart_io_read(const struct peri_ioport_content *ioport, uint8_t size, void *res)
+{
+	struct device *dev = ioport->ctx;
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+	volatile uint32_t *regs = dw_regs(cfg);
+	uint8_t off = (uint8_t)(ioport - data->content);
+	uint8_t *val = res;
+
+	ARG_UNUSED(size);
+	if (off > 7) {
+		*val = 0;
+		return;
+	}
+	if (off == 6) {
+		*val = (uint8_t)((regs[off] & 0x1f) | msr_from_gpio(cfg));
+	} else {
+		*val = (uint8_t)regs[off];
+	}
+	irq_state_update(dev);
+}
+
+static void dwuart_io_write(const struct peri_ioport_content *ioport, uint8_t size, uint8_t *wdata)
+{
+	struct device *dev = ioport->ctx;
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+	volatile uint32_t *regs = dw_regs(cfg);
+	uint8_t off = (uint8_t)(ioport - data->content);
+	uint8_t val = *wdata;
+	enum divisor_reg_status st;
+
+	ARG_UNUSED(size);
+	if (off > 7) {
+		return;
+	}
+
+	st = dlab_status((uint8_t)regs[3], val, off);
+	if (st == SET_DLAB) {
+		dwuart_reset(cfg->mmio);
+		regs[1] = data->regs.ier;
+		regs[2] = data->regs.fcr;
+		regs[3] = data->regs.lcr;
+		regs[4] = data->regs.mcr;
+		regs[7] = data->regs.scr;
+	} else if (st == CLR_DLAB) {
+		uint16_t host_div = (uint16_t)((regs[1] << 8) | (regs[0] & 0xff));
+		uint16_t hw = host_div_to_hw(cfg->clock_hz, host_div, ldn_spec1(cfg));
+
+		regs[0] = hw & 0xff;
+		regs[1] = hw >> 8;
+	}
+
+	switch (off) {
+	case 1:
+		if ((regs[3] & LCR_DLAB) == 0) {
+			data->regs.ier = val;
+		}
+		break;
+	case 2:
+		data->regs.fcr = val;
+		break;
+	case 3:
+		data->regs.lcr = val;
+		break;
+	case 4:
+		data->regs.mcr = val;
+		apply_dtr(cfg, val);
+		break;
+	case 7:
+		data->regs.scr = val;
+		break;
+	default:
+		break;
+	}
+
+	regs[off] = val;
+	irq_state_update(dev);
+}
+
+static uint8_t lsuart_iir(reg_uart_t *hw, struct sio_lsuart_shadow *ls)
+{
+	uint32_t ifm = hw->IFM;
+	uint8_t val;
+
+	if (ifm & BIT(2)) {
+		val = 0x06;
+	} else if (ifm & BIT(0)) {
+		val = 0x04;
+	} else if (ifm & BIT(4)) {
+		val = 0x0c;
+	} else if (ls->thr_flag || (ifm & BIT(1))) {
+		ls->thr_flag = 0;
+		hw->ICR = BIT(1);
+		val = 0x02;
+	} else if (ifm & BIT(3)) {
+		val = 0;
+	} else if (ifm & BIT(5)) {
+		val = 0x07;
+	} else {
+		val = 0x01;
+	}
+	if (ls->fifo_flag) {
+		val |= 0xc0;
+	}
+	return val;
+}
+
+static void lsuart_apply_baud(const struct device *dev)
+{
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+	reg_uart_t *hw = ls_hw(cfg);
+	uint16_t host_div = ((uint16_t)data->ls.dlm << 8) | data->ls.dll;
+	uint16_t hw_div = host_div_to_hw(cfg->clock_hz, host_div, ldn_spec1(cfg));
+
+	hw->LCR &= ~BIT(5);
+	hw->BRR = ((uint32_t)hw_div) << 4;
+	nop4();
+	hw->LCR |= BIT(5);
+}
+
+static void lsuart_io_read(const struct peri_ioport_content *ioport, uint8_t size, void *res)
+{
+	struct device *dev = ioport->ctx;
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+	reg_uart_t *hw = ls_hw(cfg);
+	uint8_t off = (uint8_t)(ioport - data->content);
+	uint8_t *val = res;
+	uint32_t ifm;
+
+	ARG_UNUSED(size);
+	*val = 0;
+	if (off > 7) {
+		return;
+	}
+
+	switch (off) {
+	case 0:
+		if ((data->ls.lcr & LCR_DLAB) == 0) {
+			*val = (uint8_t)hw->RBR;
+			ifm = hw->IFM;
+			if (ifm & BIT(0)) {
+				hw->ICR = BIT(0);
+			}
+			if (ifm & BIT(4)) {
+				hw->ICR = BIT(4);
+			}
+		} else {
+			*val = (uint8_t)((hw->BRR >> 4) & 0xff);
+		}
+		break;
+	case 1:
+		if ((data->ls.lcr & LCR_DLAB) == 0) {
+			*val = (uint8_t)(hw->IVS & 0x0f);
+		} else {
+			*val = (uint8_t)(hw->BRR >> 12);
+		}
+		break;
+	case 2:
+		*val = lsuart_iir(hw, &data->ls);
+		break;
+	case 3:
+		*val = (uint8_t)(hw->LCR & 0xdf);
+		break;
+	case 4:
+		*val = data->ls.mcr;
+		break;
+	case 5:
+		*val = (uint8_t)hw->SR;
+		if (hw->IFM & BIT(2)) {
+			hw->ICR = BIT(2);
+		}
+		break;
+	case 6:
+		*val = msr_from_gpio(cfg);
+		if (hw->SR & BIT(14)) {
+			*val |= BIT(4);
+		}
+		if (hw->SR & BIT(13)) {
+			*val |= BIT(0);
+		}
+		if (hw->IFM & BIT(3)) {
+			hw->ICR = BIT(3);
+		}
+		break;
+	case 7:
+		*val = data->ls.scr;
+		break;
+	default:
+		break;
+	}
+	irq_state_update(dev);
+}
+
+static void lsuart_io_write(const struct peri_ioport_content *ioport, uint8_t size, uint8_t *wdata)
+{
+	struct device *dev = ioport->ctx;
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+	reg_uart_t *hw = ls_hw(cfg);
+	uint8_t off = (uint8_t)(ioport - data->content);
+	uint8_t val = *wdata;
+	uint8_t bit67;
+
+	ARG_UNUSED(size);
+	if (off > 7) {
+		return;
+	}
+
+	if (dlab_status(data->ls.lcr, val, off) == CLR_DLAB) {
+		lsuart_apply_baud(dev);
+	}
+
+	switch (off) {
+	case 0:
+		if ((data->ls.lcr & LCR_DLAB) == 0) {
+			hw->TBR = val;
+			if (hw->IFM & BIT(1)) {
+				hw->ICR = BIT(1);
+			}
+		} else {
+			data->ls.dll = val;
+		}
+		break;
+	case 1:
+		if (data->ls.lcr & LCR_DLAB) {
+			data->ls.dlm = val;
+		} else {
+			data->ls.ier = val;
+			for (int i = 0; i <= 3; i++) {
+				if (val & BIT(i)) {
+					hw->IER = BIT(i);
+					if (i == 1) {
+						espi_lpc_raise_edge_irq(cfg->espi, data->host_irq);
+						data->ls.thr_flag = 1;
+					}
+				} else {
+					hw->IDR = BIT(i);
+				}
+			}
+		}
+		break;
+	case 2:
+		bit67 = (val & 0x30) << 2;
+		val &= 0x0f;
+		hw->FCR = val | bit67 | ((data->ls.fifo_flag ^ (val & 0x01)) ? 6 : 0);
+		data->ls.fifo_flag = val & 0x01;
+		break;
+	case 3:
+		hw->LCR &= ~BIT(5);
+		data->ls.lcr = val;
+		hw->LCR = (val & (uint8_t)~BIT(6)) | BIT(5);
+		hw->IER |= 0x10;
+		hw->LCR |= BIT(8);
+		hw->RTOR = 0x04;
+		break;
+	case 4:
+		data->ls.mcr = val;
+		if (val & BIT(5)) {
+			hw->MCR |= BIT(2);
+		} else {
+			hw->MCR &= ~BIT(2);
+		}
+		if (val & BIT(1)) {
+			hw->MCR |= BIT(3);
+		} else {
+			hw->MCR &= ~BIT(3);
+		}
+		apply_dtr(cfg, val);
+		break;
+	case 7:
+		data->ls.scr = val;
+		break;
+	default:
+		break;
+	}
+	irq_state_update(dev);
+}
+
+static int modem_gpio_init(const struct sio_uart_config *cfg)
+{
+	int ret;
+
+	if (gpio_is_ready_dt(&cfg->dtr)) {
+		ret = gpio_pin_configure_dt(&cfg->dtr, GPIO_OUTPUT_INACTIVE);
+		if (ret) {
+			return ret;
+		}
+	}
+	if (gpio_is_ready_dt(&cfg->dsr)) {
+		ret = gpio_pin_configure_dt(&cfg->dsr, GPIO_INPUT);
+		if (ret) {
+			return ret;
+		}
+	}
+	if (gpio_is_ready_dt(&cfg->ri)) {
+		ret = gpio_pin_configure_dt(&cfg->ri, GPIO_INPUT);
+		if (ret) {
+			return ret;
+		}
+	}
+	if (gpio_is_ready_dt(&cfg->dcd)) {
+		ret = gpio_pin_configure_dt(&cfg->dcd, GPIO_INPUT);
+		if (ret) {
+			return ret;
+		}
+	}
+	return 0;
+}
+
+static int sio_uart_init(const struct device *dev)
+{
+	const struct sio_uart_config *cfg = dev->config;
+	struct sio_uart_data *data = dev->data;
+	int ret;
+
+	if (!device_is_ready(cfg->espi) || !device_is_ready(cfg->sio)) {
+		LOG_ERR("parent eSPI/SIO not ready");
+		return -ENODEV;
+	}
+	if (!is_dwuart(cfg->mmio) && !is_lsuart(cfg->mmio)) {
+		LOG_ERR("unsupported UART MMIO 0x%08lx", (unsigned long)cfg->mmio);
+		return -ENODEV;
+	}
+
+	for (int i = 0; i < UART_IO_REGS; i++) {
+		if (cfg->kind == SIO_UART_LS) {
+			data->content[i].io_read = lsuart_io_read;
+			data->content[i].io_write = lsuart_io_write;
+		} else {
+			data->content[i].io_read = dwuart_io_read;
+			data->content[i].io_write = dwuart_io_write;
+		}
+		data->content[i].ctx = (struct device *)dev;
+	}
+
+	uart_clock_on(cfg->mmio);
+
+	ret = pinctrl_apply_state(cfg->pcfg, PINCTRL_STATE_DEFAULT);
+	if (ret < 0) {
+		LOG_ERR("pinctrl failed (%d)", ret);
+		return ret;
+	}
+
+	ret = modem_gpio_init(cfg);
+	if (ret) {
+		LOG_ERR("modem gpio init failed (%d)", ret);
+		return ret;
+	}
+
+	data->host_irq = cfg->default_irq;
+	cfg->irq_config(dev);
+
+	ret = sio_ls_register_uart(cfg->sio, cfg->ldn, dev, sio_uart_on_ldn_change,
+				   cfg->default_io, cfg->default_irq);
+	if (ret) {
+		return ret;
+	}
+
+	LOG_INF("COM LDN 0x%02x %s@0x%08lx default IO 0x%03x IRQ %u",
+		cfg->ldn, cfg->kind == SIO_UART_LS ? "LSUART" : "DWUART",
+		(unsigned long)cfg->mmio, cfg->default_io, cfg->default_irq);
+	return 0;
+}
+
+#define SIO_UART_KIND(idx)                                                             \
+	((DT_REG_ADDR(DT_INST_PHANDLE(idx, uart)) == UART1_BASE_ADDR ||                \
+	  DT_REG_ADDR(DT_INST_PHANDLE(idx, uart)) == UART2_BASE_ADDR) ?                 \
+		 SIO_UART_LS : SIO_UART_DW)
+
+#define SIO_UART_IRQ_CFG(idx)                                                          \
+	static void sio_uart_irq_config_##idx(const struct device *dev)                \
+	{                                                                              \
+		ARG_UNUSED(dev);                                                       \
+		IRQ_CONNECT(DT_IRQN(DT_INST_PHANDLE(idx, uart)),                       \
+			    DT_IRQ(DT_INST_PHANDLE(idx, uart), priority),              \
+			    sio_uart_isr, DEVICE_DT_INST_GET(idx), 0);                 \
+		irq_enable(DT_IRQN(DT_INST_PHANDLE(idx, uart)));                       \
+	}
+
+#define SIO_UART_INIT(idx)                                                             \
+	PINCTRL_DT_INST_DEFINE(idx);                                                   \
+	SIO_UART_IRQ_CFG(idx);                                                         \
+	static struct sio_uart_data sio_uart_data_##idx;                               \
+	static const struct sio_uart_config sio_uart_cfg_##idx = {                     \
+		.espi = DEVICE_DT_GET(DT_PARENT(DT_INST_PARENT(idx))),                 \
+		.sio = DEVICE_DT_GET(DT_INST_PARENT(idx)),                             \
+		.pcfg = PINCTRL_DT_INST_DEV_CONFIG_GET(idx),                           \
+		.dtr = GPIO_DT_SPEC_INST_GET_OR(idx, dtr_gpios, {0}),                  \
+		.dsr = GPIO_DT_SPEC_INST_GET_OR(idx, dsr_gpios, {0}),                  \
+		.ri = GPIO_DT_SPEC_INST_GET_OR(idx, ri_gpios, {0}),                    \
+		.dcd = GPIO_DT_SPEC_INST_GET_OR(idx, dcd_gpios, {0}),                  \
+		.mmio = DT_REG_ADDR(DT_INST_PHANDLE(idx, uart)),                       \
+		.clock_hz = DT_PROP(DT_INST_PHANDLE(idx, uart), clock_frequency),       \
+		.irqn = DT_IRQN(DT_INST_PHANDLE(idx, uart)),                           \
+		.default_io = DT_INST_PROP(idx, default_io),                           \
+		.default_irq = DT_INST_PROP(idx, default_irq),                         \
+		.ldn = DT_INST_PROP(idx, ldn),                                         \
+		.kind = SIO_UART_KIND(idx),                                            \
+		.irq_config = sio_uart_irq_config_##idx,                               \
+	};                                                                             \
+	DEVICE_DT_INST_DEFINE(idx, &sio_uart_init, NULL, &sio_uart_data_##idx,         \
+			      &sio_uart_cfg_##idx, POST_KERNEL,                        \
+			      SIO_UART_INIT_PRIORITY, 0);
+
+DT_INST_FOREACH_STATUS_OKAY(SIO_UART_INIT)
