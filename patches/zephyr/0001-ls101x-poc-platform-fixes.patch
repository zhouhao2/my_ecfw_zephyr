+description: |
+  Linkedsemi Super I/O UART logical device (host COM via eSPI I/O).
+
+  Child of linkedsemi,ls-sio. Host 16550 windows are mapped at runtime from
+  LDN 0x60/0x61; do not enable the referenced SoC UART as a Zephyr console.
+
+compatible: "linkedsemi,ls-sio-uart"
+
+include: [base.yaml, pinctrl-device.yaml]
+
+properties:
+  ldn:
+    type: int
+    required: true
+    description: ITE logical device number (COM1=0x01, COM2=0x02, COM3=0x08, COM4=0x09).
+
+  uart:
+    type: phandle
+    required: true
+    description: |
+      SoC UART MMIO node. COM1/2 use DWUART1/DWUART2; COM3/4 use UART1/UART2
+      (LSUART, 16550 translated in the SIO driver). Keep that node status
+      disabled so Zephyr serial does not claim it.
+
+  default-io:
+    type: int
+    required: true
+    description: Power-on host I/O base (COM1 typically 0x3f8).
+
+  default-irq:
+    type: int
+    required: true
+    description: Power-on host IRQ (COM1 typically 4).
+
+  dtr-gpios:
+    type: phandle-array
+    description: DTR output (active low).
+
+  dsr-gpios:
+    type: phandle-array
+    description: DSR input (active low).
+
+  ri-gpios:
+    type: phandle-array
+    description: RI input (active low).
+
+  dcd-gpios:
+    type: phandle-array
+    description: DCD input (active low).
