+static int espi_ls_send_vwire(const struct device *dev, enum espi_vwire_signal vw,
+			      uint8_t level)
+{
+	const struct espi_lpc_ls_config *cfg = dev->config;
+	uint8_t wire;
+
+	switch (vw) {
+	case ESPI_VWIRE_SIGNAL_OOB_RST_ACK:
+		wire = ESPI_SYS_EVT_4_OOB_RST_ACK_VLD;
+		if (level) {
+			wire |= ESPI_SYS_EVT_4_OOB_RST_ACK;
+		}
+		espi_vw_tx(dev, 1, 4, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_PME:
+		wire = ESPI_SYS_EVT_4_PME_N_VLD;
+		if (!level) {
+			wire |= ESPI_SYS_EVT_4_PME_N;
+		}
+		espi_vw_tx(dev, 1, 4, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_WAKE:
+		wire = ESPI_SYS_EVT_4_WAKE_N_VLD;
+		if (!level) {
+			wire |= ESPI_SYS_EVT_4_WAKE_N;
+		}
+		espi_vw_tx(dev, 1, 4, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_TARGET_BOOT_DONE:
+		wire = ESPI_SYS_EVT_5_SLAVE_BOOT_LOAD_DONE_VLD;
+		if (level) {
+			wire |= ESPI_SYS_EVT_5_SLAVE_BOOT_LOAD_DONE;
+		}
+		espi_vw_tx(dev, 1, 5, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_TARGET_BOOT_STS:
+		wire = ESPI_SYS_EVT_5_SLAVE_BOOT_LOAD_STATUS_VLD;
+		if (level) {
+			wire |= ESPI_SYS_EVT_5_SLAVE_BOOT_LOAD_STATUS;
+		}
+		espi_vw_tx(dev, 1, 5, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_ERR_NON_FATAL:
+		wire = ESPI_SYS_EVT_5_ERROR_NONFATAL_VLD;
+		if (level) {
+			wire |= ESPI_SYS_EVT_5_ERROR_NONFATAL;
+		}
+		espi_vw_tx(dev, 1, 5, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_ERR_FATAL:
+		wire = ESPI_SYS_EVT_5_ERROR_FATAL_VLD;
+		if (level) {
+			wire |= ESPI_SYS_EVT_5_ERROR_FATAL;
+		}
+		espi_vw_tx(dev, 1, 5, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_HOST_RST_ACK:
+		wire = ESPI_SYS_EVT_6_HOST_RST_ACK_VLD;
+		if (level) {
+			wire |= ESPI_SYS_EVT_6_HOST_RST_ACK;
+		}
+		espi_vw_tx(dev, 1, 6, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_SCI:
+		wire = ESPI_SYS_EVT_6_SCI_N_VLD;
+		if (!level) {
+			wire |= ESPI_SYS_EVT_6_SCI_N;
+		}
+		espi_vw_tx(dev, 1, 6, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_SMI:
+		wire = ESPI_SYS_EVT_6_SMI_N_VLD;
+		if (!level) {
+			wire |= ESPI_SYS_EVT_6_SMI_N;
+		}
+		espi_vw_tx(dev, 1, 6, wire);
+		break;
+	case ESPI_VWIRE_SIGNAL_SUS_ACK:
+		espi_send_sus_ack(dev, level);
+		break;
+	case ESPI_VWIRE_SIGNAL_DNX_ACK:
+		cfg->sysevent_base->s06_sm = level ? 0x0f : 0x00;
+		espi_vw_tx(dev, 1, 6, cfg->sysevent_base->s06_sm);
+		break;
+	default:
+		LOG_WRN("send_vwire unsupported %d", vw);
+		return -ENOTSUP;
+	}
+
+	return 0;
+}
